# Use the same base image as the API to ensure compatibility
FROM python:3.12-slim

# Set the working directory in the container
WORKDIR /app

# Install system dependencies required for moviepy, imageio, and opencv
# Added build-essential and python3-dev for compilation support
RUN apt-get update && apt-get install -y \
    build-essential \
    python3-dev \
    curl \
    ffmpeg \
    imagemagick \
    libsm6 \
    libxext6 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Fix ImageMagick policy to allow PDF/Text operations
RUN sed -i 's/none/read,write/g' /etc/ImageMagick-6/policy.xml || true

# Copy the requirements file into the container
COPY requirements.txt .

# Install any needed packages specified in requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the current directory contents into the container at /app
COPY . .

# Narration Core v1: API and worker share the exact same source-owned parser.
# The worker uses the same V2/legacy UI bridge so any historical hardening
# script that touches app/static/index.html cannot overwrite the focused shell.
# Compatibility contract executed transitively by run_build_hardening.py:
# apply_duration_seconds_support.py --apply
# apply_duration_seconds_support.py --check
RUN python scripts/run_build_hardening.py --profile worker && \
    python -m compileall -q app scripts && \
    python scripts/codexia_v2_legacy_ui_bridge.py check

# Create directory for static files and temp storage
RUN mkdir -p app/static/videos app/static/covers app/static/icons app/static/temp

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Coolify can distinguish a live container from a healthy worker. The endpoint
# checks this process, Redis, PostgreSQL, and the RQ registration.
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD curl --fail --silent --show-error --max-time 4 http://127.0.0.1:8081/health

# A mesma linhagem Alembic é obrigatória para API e worker. O runner usa
# advisory lock no PostgreSQL para serializar startups simultâneos.
CMD ["sh", "-c", "python scripts/apply_migrations.py && python app/worker.py"]
