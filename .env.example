APP_ENV=production
PORT=8000
BASE_URL=http://localhost:8000
SECRET_KEY=troque-por-uma-chave-forte

# Admin inicial
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# Melhor opcao de banco para producao:
# Use DATABASE_URL apontando para PostgreSQL (Coolify ou servico gerenciado)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codexia

# Opcional: caso prefira montar URL por partes em vez de DATABASE_URL
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=codexia
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_SSLMODE=disable

# Opcional: tuning de pool para PostgreSQL
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
